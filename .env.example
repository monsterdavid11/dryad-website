PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=./data/playoverlay.sqlite
# Demo account is available locally only. Production requires this to be false.
DEMO_MODE=true
# Stripe TEST credentials only; never put these in VITE_ variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PORTAL_CONFIGURATION=
LICENSE_KEY_PATH=./data/keys/license.pem
# LOCAL TESTING ONLY: grant an explicit 24-hour license using tools/dev-membership.js.
DEV_LICENSES=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Intended production origin: https://dryadclient.dev
LISTEN_HOST=127.0.0.1
TRUST_PROXY_HOPS=0
# Set NODE_ENV=production and APP_ORIGIN to your HTTPS origin when deploying.
